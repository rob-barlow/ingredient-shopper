# Ingredient Shopper: backend configuration (plan §9)
# Copy to `.env` and fill in real values. `.env` is git-ignored: never commit it.
# Format: KEY=value, one per line, NO quotes (read as a .properties file by the backend).
# Real environment variables override anything in this file.
# The frontend is configured separately in frontend/wwwroot/appsettings.json (ApiBaseUrl).

# --- Database (PostgreSQL) ---------------------------------------------------
DB_URL=jdbc:postgresql://localhost:5432/shopper
DB_USER=shopper
DB_PASSWORD=change-me

# --- Admin account (000 §5.1: exactly one) -----------------------------------
ADMIN_USERNAME=glenda
# A bcrypt hash, NOT the password itself (how to generate one: docs/local-setup.md).
# No quotes: the backend reads this file as .properties, where quotes become part of the value.
ADMIN_PASSWORD_BCRYPT=$2b$12$replace.with.a.real.bcrypt.hash..................

# --- Secret codes (ADR-010) --------------------------------------------------
# Any long random string. Changing it later makes existing orders unfindable by code.
SECRET_CODE_HMAC_KEY=replace-with-a-long-random-string

# --- Claude API (006, ADR-012) -----------------------------------------------
ANTHROPIC_API_KEY=sk-ant-replace-me
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- HTTP --------------------------------------------------------------------
SERVER_PORT=8081
CORS_ALLOWED_ORIGINS=http://localhost:5000

# --- Demo data (ADR-017) -----------------------------------------------------
# true = load Glenda's demo catalogue. Use for local dev, demos and API tests.
SEED_DEMO_DATA=true
